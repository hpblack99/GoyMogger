# React frontend environment variables
# Copy to .env and fill in values from your Supabase project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Power Automate flow URL for the AI analytics assistant (HTTP trigger "invoke" URL)
VITE_PA_CHAT_URL=https://<your-env>.environment.api.powerplatform.com/powerautomate/automations/direct/workflows/<id>/triggers/manual/paths/invoke?api-version=1
