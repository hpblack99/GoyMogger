# React frontend environment variables
# Copy to .env and fill in values from your Supabase project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Power Automate URL goes in Supabase Edge Function secrets (NOT here) — see README
# Set it via: Supabase Dashboard → Edge Functions → pa-chat-proxy → Secrets → PA_CHAT_URL
