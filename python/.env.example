# Copy to python/.env and fill in your values

# From your Supabase project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # NOT the anon key — needs write access

# Your FFE login credentials (ffeinc.com)
FFE_USERNAME=your@email.com
FFE_PASSWORD=yourpassword

# FreshX login credentials (app.getfreshx.com) — leave blank to run FFE only
FRESHX_USERNAME=
FRESHX_PASSWORD=

# Set to true for slow-motion + extra logging while debugging selectors
DEBUG=false

# Browser visibility. The browser is shown by default so you can watch it work.
# Set HEADLESS=true to run without a window (e.g. on a server with no display).
HEADLESS=false

# How often the worker checks Supabase for new jobs (seconds)
POLL_INTERVAL=5
