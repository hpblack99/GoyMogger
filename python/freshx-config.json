{
  "_comment": "FreshX selectors — run with DEBUG=true to see the browser. Screenshots saved to python/screenshots/.",
  "urls": {
    "login":       "https://app.getfreshx.com/login",
    "bulk_search": "https://app.getfreshx.com/bulk-search"
  },
  "login": {
    "email":    "input[type='email'], input[name='email'], #email",
    "password": "input[type='password'], input[name='password'], #password",
    "submit":   "button[type='submit']",
    "error":    "[class*='error'], [class*='alert'], [role='alert']"
  },
  "bulk_search": {
    "upload_trigger": "button:has-text('Upload File'), button:has-text('Upload Bulk'), button:has-text('New Search'), button:has-text('Bulk Search'), button:has-text('Upload')",
    "file_input":     "input[type='file']",
    "submit_button":  "button:has-text('Upload')",
    "download_button":"button[aria-haspopup='menu'], button:has-text('Download'), a:has-text('Download')",
    "csv_option":     "[role='menuitem']:has-text('CSV'), [role='menuitem']:has-text('Export'), li:has-text('CSV'), button:has-text('CSV'), a:has-text('CSV'), [data-value='csv'], [role='menuitem']"
  },
  "results_csv": {
    "rate_columns":    ["total rate", "rate", "price", "total_price", "total_charge", "quoted_rate", "best_rate", "amount", "cost", "net_charge"],
    "carrier_columns": ["carrier", "carrier_name", "provider", "scac", "carrier_scac", "carrier_id"],
    "id_columns":      ["external id", "external_id", "id", "lane_id", "reference", "ref_id"],
    "from_columns":    ["from zip", "from_zip", "origin_zip", "origin", "from", "shipper_zip"],
    "to_columns":      ["to zip", "to_zip", "destination_zip", "destination", "to", "consignee_zip"]
  }
}
